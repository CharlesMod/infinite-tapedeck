[Unit]
Description=ComfyUI (MiniMax Music 3)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/path/to/tapedeck/ComfyUI
ExecStart=/path/to/venv/bin/python /path/to/tapedeck/ComfyUI/main.py \
    --port 8189 \
    --reserve-vram 1.2 \
    --listen 0.0.0.0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
