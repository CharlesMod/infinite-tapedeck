venv/
# library/* not library/: an ignored DIRECTORY is never descended into, so a
# !library/.gitkeep negation inside it can never match. Ignoring the contents
# instead lets the placeholder through, and the install docs tell people to
# put music in a folder that therefore survives a clone.
library/*
!library/.gitkeep
stations/
radio/tank/
radio/keepers/
radio/*.jsonl
radio/stations.json
radio/weights.json
analysis/*.json
analysis/*.jsonl
analysis/*.npy
analysis/clap_windows/
analysis/*.log
analysis/description.txt
comfyui_node/music_studio/tapedeck_base.txt
__pycache__/
*.pyc
